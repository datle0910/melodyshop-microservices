# ========================================
# MelodyShop Microservices - Template Env
# Copy this file to '.env' and fill in the values
# ========================================

# --- Database Credentials ---
DB_USERNAME=melodyshop
DB_PASSWORD=your_secure_db_password

AUTH_DB_NAME=auth_db
PRODUCT_DB_NAME=product_db
ORDER_DB_NAME=order_db
USER_DB_NAME=user_db
INVENTORY_DB_NAME=inventory_db

# --- MariaDB Root ---
MARIADB_ROOT_PASSWORD=your_root_database_password

# --- JWT ---
# Use a strong base64 encoded string here
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Mail (Gmail SMTP or Mailtrap) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# --- Eureka ---
EUREKA_HOST=eureka-server
EUREKA_PORT=8761
