# ========================================
# MelodyShop Microservices - Template Env
# Copy this file to '.env' and fill in the real values
# NEVER commit the actual .env file to Git!
# ========================================

# --- Database Credentials ---
DB_USERNAME=melodyshop
DB_PASSWORD=your_secure_db_password

AUTH_DB_NAME=auth_db
PRODUCT_DB_NAME=product_db
ORDER_DB_NAME=order_db
USER_DB_NAME=user_db
ORDER_DB_NAME=order_db
INVENTORY_DB_NAME=inventory_db

# --- MariaDB Root ---
MARIADB_ROOT_PASSWORD=your_root_database_password

# --- JWT ---
# Use a strong base64 encoded string (min 256 bits)
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Notification Service (Gmail SMTP) ---
# HOW TO GET APP PASSWORD:
#   1. Enable 2FA on your Google Account
#   2. Go to: Google Account → Security → App Passwords
#   3. Generate a password for "Mail" → use it here
#  vào link này tạo ứng dụng tên melodyshop: https://myaccount.google.com/apppasswords _> khi đó sẽ tạo 1 password
#  điền gmail của bạn và password ở trên vào nhớ bỏ dấu cách
MAIL_USERNAME=your-gmail@gmail.com
MAIL_APP_PASSWORD=your_16_char_app_password

# --- Media Service (Cloudinary) ---
# HOW TO GET THESE:
#   1. Create a free account at https://cloudinary.com
#   2. Dashboard → API Keys → copy Cloud Name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Eureka ---
EUREKA_HOST=eureka-server
EUREKA_PORT=8761

# --- ELK Stack (optional) ---
# Leave empty for normal dev mode.
# Set to "logstash" when running with docker-compose.elk.yml
LOGSTASH_HOST=
